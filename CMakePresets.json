{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "pc_debug_clang",
            "displayName": "PC Debug Clang",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "UTEST": "true"
            }
        },
        {
            "name": "pc_debug_clang_docker",
            "displayName": "Docker with clang and without sudo",
            "inherits": "pc_debug_clang",
            "cacheVariables": {
                "NOSUDO": "true"
            }
        },
        {
            "name": "pc_debug_clang_trace",
            "displayName": "PC Debug Clang with trace",
            "inherits": "pc_debug_clang",
            "cacheVariables": {
                "TRACE": "true"
            }
        },
        {
            "name": "pc_release_clang",
            "displayName": "PC Release Clang with trace",
            "inherits": "pc_debug_clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "freertos_debug_clang",
            "displayName": "freeRTOS Debug Clang",
            "inherits": "pc_debug_clang",
            "cacheVariables": {
                "FREERTOS": "true"
            }
        },
        {
            "name": "freertos_release_clang",
            "displayName": "freeRTOS Release Clang",
            "inherits": "pc_debug_clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "freertos_debug_clang_trace",
            "displayName": "freeRTOS Debug Clang with trace",
            "inherits": "freertos_debug_clang",
            "cacheVariables": {
                "TRACE": "true"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build_pc_debug_clang",
            "configurePreset": "pc_debug_clang"
        },
        {
            "name": "build_pc_release_clang",
            "configurePreset": "pc_release_clang"
        },
        {
            "name": "build_freertos_debug_clang",
            "configurePreset": "freertos_debug_clang"
        }
    ],
    "testPresets": [
        {
            "name": "test_pc_debug_clang",
            "configurePreset": "pc_debug_clang",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true,
                "timeout": 10
            }
        },
        {
            "name": "test_pc_release_clang",
            "configurePreset": "pc_release_clang",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true,
                "timeout": 10
            }
        },
        {
            "name": "test_freertos_debug_clang",
            "configurePreset": "freertos_debug_clang",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true,
                "timeout": 10
            }
        },
        {
            "name": "test_freertos_release_clang",
            "configurePreset": "freertos_release_clang",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true,
                "timeout": 10
            }
        }
    ]
}