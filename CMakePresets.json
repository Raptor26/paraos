{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "win_api_clang_debug",
            "displayName": "PARAOS wrapper for Windows Debug Clang",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "UTEST": "true"
            }
        },
        {
            "name": "win_api_clang_debug_trace",
            "displayName": "PARAOS wrapper for Windows Debug Clang with trace",
            "inherits": "win_api_clang_debug",
            "cacheVariables": {
                "TRACE": "true"
            }
        }
    ],
    "testPresets": [
        {
            "name": "test_win_api_debug",
            "configurePreset": "win_api_clang_debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        }
    ]
}