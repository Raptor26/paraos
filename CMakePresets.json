{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "pc_debug_clang",
            "displayName": "PC Debug Clang",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "UTEST": "true"
            }
        },
        {
            "name": "pc_debug_clang_docker",
            "displayName": "Docker with clang and without sudo",
            "inherits": "pc_debug_clang",
            "cacheVariables": {
                "NOSUDO": "true"
            }
        },
        {
            "name": "pc_debug_clang_trace",
            "displayName": "PC Debug Clang with trace",
            "inherits": "pc_debug_clang",
            "cacheVariables": {
                "TRACE": "true"
            }
        }
    ],
    "testPresets": [
        {
            "name": "test_pc_debug_clang",
            "configurePreset": "pc_debug_clang",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        }
    ]
}